# Summon's Ghostty config. Installed to ~/.config/ghostty/config by /summon:setup.
# Colors and font come from the current Summon theme (regenerated by `summon theme set`).
config-file = ?~/.config/summon/current/ghostty.conf

window-padding-x = 14
window-padding-y = 10
window-decoration = auto
macos-titlebar-style = tabs
macos-option-as-alt = left
confirm-close-surface = false
shell-integration-features = cursor,sudo,title

# Drop-down console, Quake-style, from anywhere (needs Accessibility for Ghostty).
# Type `a` in it to summon the agent.
keybind = global:ctrl+alt+super+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.18
quick-terminal-autohide = true
