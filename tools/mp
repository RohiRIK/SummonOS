#!/usr/bin/env bash
# shellcheck disable=SC2016 # jq programs use $vars inside single quotes on purpose
# mp: the plugin home manager. plugins.json is the registry; plugins.md is generated from it.
#
#   mp new <name> [--kind menubar|app|screensaver] [--panel]   scratch/<name> from examples/<kind>-starter
#                                                    (--panel: menubar-panel-starter, NSStatusItem + NSPanel), registered
#   mp promote <name> [--owner <login>] [--yes]      private <name>-dev + public <name> repos, move to plugins/
#   mp clone (<name>... | --all)                     clone registered dev repos into plugins/<name>
#   mp list [--json]                                 registered plugins
#   mp status                                        branch, dirty, version, registry vs disk
#   mp index [--check]                               regenerate plugins.md (--check: fail if stale)
#   mp adopt <path> [--name n] [--kind k] [--status s]   register an existing folder
#   mp home                                          print the plugin home
#
# Home: $MACPLUGINS_HOME, else the repo that holds this script, else ~/Developer/macplugins.
# Needs bash 3.2+ (macOS default), jq, git; gh for promote and clone.
set -euo pipefail

KINDS="menubar app cli claude-plugin screensaver"
STATUSES="scratch incubating dev shipped archived"

die() { echo "mp: $*" >&2; exit 1; }
note() { echo "mp: $*" >&2; }

resolve_script_dir() {
  local src=${BASH_SOURCE[0]} dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

script_dir=$(resolve_script_dir)
if [ -n "${MACPLUGINS_HOME:-}" ]; then
  HOME_DIR=$MACPLUGINS_HOME
elif [ -f "$script_dir/../plugins.json" ]; then
  HOME_DIR=$(cd "$script_dir/.." && pwd -P)
else
  HOME_DIR="$HOME/Developer/macplugins"
fi
REG="$HOME_DIR/plugins.json"
INDEX="$HOME_DIR/plugins.md"

need_jq() { command -v jq >/dev/null 2>&1 || die "jq is required (brew install jq)"; }
need_reg() { need_jq; [ -f "$REG" ] || die "no registry at $REG (set MACPLUGINS_HOME)"; }

in_list() { # word list...
  local w=$1 x
  shift
  for x in "$@"; do [ "$x" = "$w" ] && return 0; done
  return 1
}

valid_name() { printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9]*(-[a-z0-9]+)*$'; }

pascal() { printf '%s' "$1" | awk -F- '{ for (i = 1; i <= NF; i++) printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2) }'; }

# plist_value <Info.plist> <key>: the <string> after <key>, on the same or a following line.
plist_value() {
  [ -f "$1" ] || return 0
  awk -v k="<key>$2</key>" '
    function grab(s) { if (match(s, /<string>[^<]*<\/string>/)) { print substr(s, RSTART + 8, RLENGTH - 17); exit } }
    found { grab($0) }
    !found && index($0, k) { found = 1; grab(substr($0, index($0, k) + length(k))) }
  ' "$1"
}

# table: align tab-separated stdin into columns (column(1) is not installed everywhere).
table() {
  awk -F '\t' '
    { rows[NR] = $0; for (i = 1; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i) }
    END {
      for (r = 1; r <= NR; r++) {
        n = split(rows[r], f, "\t"); line = ""
        for (i = 1; i <= n; i++) line = line (i < n ? sprintf("%-" w[i] "s  ", f[i]) : f[i])
        print line
      }
    }'
}

entry() { jq -c --arg n "$1" '.plugins[] | select(.name == $n)' "$REG"; }

# reg_update <jq filter> [jq args...]: rewrite the registry in place.
reg_update() {
  local filter=$1 tmp
  shift
  tmp=$(mktemp "$REG.XXXXXX")
  if jq --indent 2 "$@" "$filter" "$REG" >"$tmp"; then
    mv "$tmp" "$REG"
  else
    rm -f "$tmp"
    die "could not update $REG"
  fi
}

# ---------------------------------------------------------------- index

render_index() {
  jq -j '
    def link(r): "[\(r)](https://github.com/\(r))";
    def cell(r): if r == null then "-" else link(r) end;
    def title: .title // .name;
    def status_text: .statusNote // .status;
    def ported:
      if .portedFrom == null then "new"
      else "[\(.portedFrom.name)](\(.portedFrom.url))"
        + (if .portedFrom.platform then " (\(.portedFrom.platform))" else "" end)
      end;
    def section($heading; $header; rows):
      if (rows | length) == 0 then "" else "\n## \($heading)\n\n\($header)" + (rows | join("")) end;
    .plugins as $p
    | "# Plugins\n\n"
    + "| Plugin | Ported from | Public repo | Dev repo (private) | Status |\n|---|---|---|---|---|\n"
    + ($p | map(select(.status == "shipped" or .status == "dev")
        | "| \(title) | \(ported) | \(cell(.publicRepo)) | \(cell(.devRepo))"
          + (if .devRepoNote then " (\(.devRepoNote))" else "" end)
          + " | \(status_text) |\n") | join(""))
    + section("In progress (in this repo, not yet in their own repos)";
        "| Plugin | What it is | Where | Status |\n|---|---|---|---|\n";
        $p | map(select(.status == "incubating")
          | "| \(title) | \(.summary // "") | \(.where // "`\(.path)/`") | \(status_text) |\n"))
    + section("Scratch (local only, no repo yet)";
        "| Plugin | Kind | Where |\n|---|---|---|\n";
        $p | map(select(.status == "scratch") | "| \(title) | \(.kind) | `\(.path)/` |\n"))
    + section("Archived";
        "| Plugin | Dev repo (private) | Status |\n|---|---|---|\n";
        $p | map(select(.status == "archived") | "| \(title) | \(cell(.devRepo)) | \(status_text) |\n"))
  ' "$REG"
}

write_index() {
  local tmp
  tmp=$(mktemp "$INDEX.XXXXXX")
  render_index >"$tmp"
  mv "$tmp" "$INDEX"
}

cmd_index() {
  need_reg
  case "${1:-}" in
    --check)
      if render_index | cmp -s - "$INDEX"; then
        echo "plugins.md is current"
      else
        echo "mp: plugins.md is stale; run tools/mp index and commit it" >&2
        render_index | diff -u "$INDEX" - >&2 || true
        return 1
      fi
      ;;
    "")
      write_index
      echo "wrote $INDEX"
      ;;
    *) die "usage: mp index [--check]" ;;
  esac
}

# ---------------------------------------------------------------- list / status

cmd_list() {
  need_reg
  if [ "${1:-}" = "--json" ]; then
    jq '.plugins' "$REG"
    return
  fi
  [ $# -eq 0 ] || die "usage: mp list [--json]"
  {
    printf 'NAME\tKIND\tSTATUS\tVERSION\tPATH\n'
    jq -r '.plugins[] | [.name, .kind, .status, (.version // "-"), .path] | @tsv' "$REG"
  } | table
}

cmd_status() {
  need_reg
  [ $# -eq 0 ] || die "usage: mp status"
  local name path dir branch dirty disk_version check reg_version reg_bundle disk_bundle
  {
    printf 'NAME\tBRANCH\tDIRTY\tVERSION\tCHECK\n'
    while IFS="$(printf '\t')" read -r name path reg_version reg_bundle; do
      dir="$HOME_DIR/$path"
      branch="-" dirty="-" disk_version="-" check="ok"
      if [ ! -d "$dir" ]; then
        check="missing on disk ($path)"
      else
        if [ -e "$dir/.git" ]; then
          branch=$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null || echo detached)
          if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then dirty=yes; else dirty=no; fi
        elif git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          branch="(in $(basename "$HOME_DIR"))"
          if [ -n "$(git -C "$dir" status --porcelain -- . 2>/dev/null)" ]; then dirty=yes; else dirty=no; fi
        fi
        disk_version=$(plist_value "$dir/Resources/Info.plist" CFBundleShortVersionString)
        disk_bundle=$(plist_value "$dir/Resources/Info.plist" CFBundleIdentifier)
        if [ -n "$disk_version" ] && [ "$reg_version" != "-" ] && [ "$disk_version" != "$reg_version" ]; then
          check="version: registry $reg_version, disk $disk_version"
        elif [ -n "$disk_bundle" ] && [ "$reg_bundle" != "-" ] && [ "$disk_bundle" != "$reg_bundle" ]; then
          check="bundleId: registry $reg_bundle, disk $disk_bundle"
        fi
        [ -n "$disk_version" ] || disk_version="$reg_version"
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$branch" "$dirty" "$disk_version" "$check"
    done < <(jq -r '.plugins[] | [.name, .path, (.version // "-"), (.bundleId // "-")] | @tsv' "$REG")

    # Folders on disk that the registry does not know.
    local area d rel
    for area in plugins scratch; do
      [ -d "$HOME_DIR/$area" ] || continue
      for d in "$HOME_DIR/$area"/*/; do
        [ -d "$d" ] || continue
        rel="$area/$(basename "$d")"
        if [ -z "$(jq -r --arg p "$rel" '.plugins[] | select(.path == $p) | .name' "$REG")" ]; then
          printf '%s\t-\t-\t-\t%s\n' "$(basename "$d")" "not registered ($rel); run mp adopt $rel"
        fi
      done
    done
  } | table
}

# ---------------------------------------------------------------- new

cmd_new() {
  need_reg
  local name="" kind="menubar" panel=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --panel) panel=1; shift ;;
      --kind) [ $# -ge 2 ] || die "--kind needs a value"; kind=$2; shift 2 ;;
      --kind=*) kind=${1#--kind=}; shift ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$name" ] || die "one name only"; name=$1; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: mp new <name> [--kind $(echo "$KINDS" | tr ' ' '|')] [--panel]"
  valid_name "$name" || die "name must be kebab-case (like mac-battery): $name"
  # shellcheck disable=SC2086
  in_list "$kind" $KINDS || die "kind must be one of: $KINDS"
  [ -z "$(entry "$name")" ] || die "$name is already registered (mp list)"

  local starter="$HOME_DIR/examples/$kind-starter"
  if [ -n "$panel" ]; then
    [ "$kind" = "menubar" ] || die "--panel is for --kind menubar"
    starter="$HOME_DIR/examples/menubar-panel-starter"
  fi
  if [ ! -d "$starter" ]; then
    case "$kind" in
      app | screensaver)
        note "no $kind starter yet; copied menubar-starter (replace its MenuBarExtra scene for this $kind)"
        starter="$HOME_DIR/examples/menubar-starter"
        ;;
      *) die "no starter for kind $kind; create the folder yourself and run mp adopt" ;;
    esac
  fi
  [ -d "$starter" ] || die "starter not found: $starter"

  local dest="$HOME_DIR/scratch/$name" old_name old_pascal new_pascal
  [ ! -e "$dest" ] || die "$dest already exists"
  old_name=$(basename "$starter")
  old_pascal="Starter"
  new_pascal=$(pascal "$name")

  mkdir -p "$HOME_DIR/scratch"
  cp -R "$starter" "$dest"
  rm -rf "$dest/.build" "$dest/.swiftpm" "$dest/build"

  # Rename paths (deepest first), then file contents.
  local p base newbase f tmp
  find "$dest" -depth -name "*$old_pascal*" | while IFS= read -r p; do
    base=$(basename "$p")
    newbase=$(printf '%s' "$base" | sed "s/$old_pascal/$new_pascal/g")
    mv "$p" "$(dirname "$p")/$newbase"
  done
  find "$dest" -type f | while IFS= read -r f; do
    if grep -q -e "$old_pascal" -e "$old_name" "$f"; then
      tmp=$(mktemp)
      sed -e "s/$old_name/$name/g" -e "s/$old_pascal/$new_pascal/g" "$f" >"$tmp"
      cat "$tmp" >"$f"
      rm -f "$tmp"
    fi
  done

  git -C "$dest" init -q
  git -C "$dest" symbolic-ref HEAD refs/heads/main

  local version bundle
  version=$(plist_value "$dest/Resources/Info.plist" CFBundleShortVersionString)
  bundle=$(plist_value "$dest/Resources/Info.plist" CFBundleIdentifier)
  reg_update '.plugins += [{
      name: $n, kind: $k, status: "scratch", devRepo: null, publicRepo: null,
      bundleId: (if $b == "" then null else $b end), portedFrom: null,
      version: (if $v == "" then null else $v end), example: false, path: ("scratch/" + $n)
    }]' --arg n "$name" --arg k "$kind" --arg b "$bundle" --arg v "$version"
  write_index

  echo "Created scratch/$name ($new_pascal, $kind) and registered it."
  echo "Next: cd \"$dest\" && swift build && swift test"
  echo "Commit plugins.json and plugins.md in the workspace. Promote only with the owner's OK: mp promote $name"
}

# ---------------------------------------------------------------- promote

cmd_promote() {
  need_reg
  local name="" owner="${MP_GH_OWNER:-}" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --owner) [ $# -ge 2 ] || die "--owner needs a value"; owner=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$name" ] || die "one name only"; name=$1; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: mp promote <name> [--owner <login>] [--yes]"
  local e path dev_repo
  e=$(entry "$name")
  [ -n "$e" ] || die "$name is not registered"
  path=$(printf '%s' "$e" | jq -r '.path')
  dev_repo=$(printf '%s' "$e" | jq -r '.devRepo // empty')
  [ -z "$dev_repo" ] || die "$name already has a dev repo: $dev_repo"
  if [ -z "$owner" ]; then
    owner=$(jq -r '[.plugins[].devRepo // empty][0] // empty | split("/")[0]' "$REG")
  fi
  [ -n "$owner" ] || die "no GitHub owner; pass --owner <login>"

  local src="$HOME_DIR/$path" dest="$HOME_DIR/plugins/$name"
  [ -d "$src" ] || die "$src does not exist"
  if [ "$src" != "$dest" ]; then [ ! -e "$dest" ] || die "$dest already exists"; fi

  echo "mp promote $name will run:"
  echo "  gh repo create $owner/$name-dev --private"
  echo "  gh repo create $owner/$name --public"
  [ "$src" = "$dest" ] || echo "  mv $path plugins/$name"
  echo "  git -C plugins/$name commit (initial commit, only if there is none)"
  echo "  git -C plugins/$name remote add origin https://github.com/$owner/$name-dev.git"
  echo "  git -C plugins/$name push -u origin HEAD"
  echo "  update plugins.json (status dev, repos, path) and plugins.md"
  if [ "$yes" -ne 1 ]; then
    echo
    echo "Nothing was run. This creates GitHub repos, so it needs the owner's OK each time."
    echo "Confirm by re-running: mp promote $name --yes"
    return 0
  fi
  command -v gh >/dev/null 2>&1 || die "gh is required"

  gh repo create "$owner/$name-dev" --private
  gh repo create "$owner/$name" --public
  if [ "$src" != "$dest" ]; then
    mkdir -p "$HOME_DIR/plugins"
    mv "$src" "$dest"
  fi
  [ -e "$dest/.git" ] || git -C "$dest" init -q
  if ! git -C "$dest" rev-parse -q --verify HEAD >/dev/null; then
    git -C "$dest" add -A
    git -C "$dest" commit -q -m "feat: initial scaffold"
  fi
  git -C "$dest" remote add origin "https://github.com/$owner/$name-dev.git"
  git -C "$dest" push -u origin HEAD
  reg_update '(.plugins[] | select(.name == $n)) |= (.status = "dev" | .devRepo = $d | .publicRepo = $p | .path = $path)' \
    --arg n "$name" --arg d "$owner/$name-dev" --arg p "$owner/$name" --arg path "plugins/$name"
  write_index
  echo "Promoted $name to plugins/$name. Publish a snapshot later: tools/publish-public.sh plugins/$name main \"<message>\""
}

# ---------------------------------------------------------------- clone

cmd_clone() {
  need_reg
  local all=0 names="" n
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      -*) die "unknown option $1" ;;
      *) names="$names $1"; shift ;;
    esac
  done
  if [ "$all" -eq 1 ]; then
    names=$(jq -r '.plugins[] | select(.devRepo != null and (.path | startswith("plugins/"))) | .name' "$REG")
  fi
  [ -n "$names" ] || die "usage: mp clone (<name>... | --all)"

  local e repo path dest failed=0
  for n in $names; do
    e=$(entry "$n")
    if [ -z "$e" ]; then note "$n is not registered"; failed=1; continue; fi
    repo=$(printf '%s' "$e" | jq -r '.devRepo // empty')
    path=$(printf '%s' "$e" | jq -r '.path')
    if [ -z "$repo" ]; then note "$n has no dev repo yet (status $(printf '%s' "$e" | jq -r .status))"; failed=1; continue; fi
    dest="$HOME_DIR/$path"
    if [ -e "$dest" ]; then echo "$n: already at $path"; continue; fi
    mkdir -p "$(dirname "$dest")"
    if command -v gh >/dev/null 2>&1; then
      gh repo clone "$repo" "$dest"
    else
      git clone "https://github.com/$repo.git" "$dest"
    fi
    echo "$n: cloned $repo into $path"
  done
  return "$failed"
}

# ---------------------------------------------------------------- adopt

cmd_adopt() {
  need_reg
  local dir="" name="" kind="" status=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || die "--name needs a value"; name=$2; shift 2 ;;
      --kind) [ $# -ge 2 ] || die "--kind needs a value"; kind=$2; shift 2 ;;
      --status) [ $# -ge 2 ] || die "--status needs a value"; status=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$dir" ] || die "one path only"; dir=$1; shift ;;
    esac
  done
  [ -n "$dir" ] || die "usage: mp adopt <path> [--name n] [--kind k] [--status s]"
  case "$dir" in /*) ;; *) [ -d "$dir" ] || dir="$HOME_DIR/$dir" ;; esac
  [ -d "$dir" ] || die "not a folder: $dir"
  local abs home_abs rel
  abs=$(cd "$dir" && pwd -P)
  home_abs=$(cd "$HOME_DIR" && pwd -P)
  case "$abs" in "$home_abs"/*) rel=${abs#"$home_abs"/} ;; *) die "$abs is outside $home_abs" ;; esac

  [ -n "$name" ] || name=$(basename "$abs")
  valid_name "$name" || die "name must be kebab-case: $name (pass --name)"
  [ -z "$(entry "$name")" ] || die "$name is already registered"
  [ -z "$(jq -r --arg p "$rel" '.plugins[] | select(.path == $p) | .name' "$REG")" ] || die "$rel is already registered"

  local plist="$abs/Resources/Info.plist"
  if [ -z "$kind" ]; then
    if grep -q LSUIElement "$plist" 2>/dev/null; then kind=menubar
    elif [ -f "$plist" ]; then kind=app
    elif [ -d "$abs/.claude-plugin" ]; then kind=claude-plugin
    else kind=cli; fi
  fi
  if [ -z "$status" ]; then
    case "$rel" in plugins/*) status=dev ;; scratch/*) status=scratch ;; *) status=incubating ;; esac
  fi
  # shellcheck disable=SC2086
  in_list "$kind" $KINDS || die "kind must be one of: $KINDS"
  # shellcheck disable=SC2086
  in_list "$status" $STATUSES || die "status must be one of: $STATUSES"

  local remote dev_repo="" version bundle
  remote=$(git -C "$abs" remote get-url origin 2>/dev/null || true)
  if [ -n "$remote" ] && [ -e "$abs/.git" ]; then
    dev_repo=$(printf '%s' "$remote" | sed -nE 's#^.*github\.com[:/]([^/]+/[^/]+)$#\1#p' | sed 's/\.git$//')
  fi
  version=$(plist_value "$plist" CFBundleShortVersionString)
  bundle=$(plist_value "$plist" CFBundleIdentifier)
  reg_update '.plugins += [{
      name: $n, kind: $k, status: $s, devRepo: (if $d == "" then null else $d end), publicRepo: null,
      bundleId: (if $b == "" then null else $b end), portedFrom: null,
      version: (if $v == "" then null else $v end), example: false, path: $p
    }]' --arg n "$name" --arg k "$kind" --arg s "$status" --arg d "$dev_repo" \
    --arg b "$bundle" --arg v "$version" --arg p "$rel"
  write_index
  echo "Registered $name ($kind, $status) at $rel. Fill in publicRepo, portedFrom and notes in plugins.json if they apply, then mp index."
}

# ---------------------------------------------------------------- main

usage() { sed -n '3,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

cmd=${1:-}
[ $# -eq 0 ] || shift
case "$cmd" in
  new) cmd_new "$@" ;;
  promote) cmd_promote "$@" ;;
  clone) cmd_clone "$@" ;;
  list) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
  index) cmd_index "$@" ;;
  adopt) cmd_adopt "$@" ;;
  home) echo "$HOME_DIR" ;;
  -h | --help | help | "") usage ;;
  *) die "unknown command: $cmd (mp help)" ;;
esac
